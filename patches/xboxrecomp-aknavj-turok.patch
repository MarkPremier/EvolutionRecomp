+    dsp->registers[DSP_REG_SR] &= BITMASK(16)-((1<<DSP_SR_C)|(1<<DSP_SR_N)|(1<<DSP_SR_Z)|(1<<DSP_SR_V));
+    dsp->registers[DSP_REG_SR] |= carry << DSP_SR_C;
+    dsp->registers[DSP_REG_SR] |= ((v >> 23) & 1) << DSP_SR_N;
+    dsp->registers[DSP_REG_SR] |= (v == 0) << DSP_SR_Z;
