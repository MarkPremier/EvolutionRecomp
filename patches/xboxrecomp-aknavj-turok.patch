+            int x0 = x * width / size, x1 = (x + 1) * width / size;
+            int y0 = y * height / size, y1 = (y + 1) * height / size, sx, sy;
+            unsigned sum[4] = {0, 0, 0, 0}, n = 0, a;
+            if (x1 <= x0) x1 = x0 + 1;
+            if (y1 <= y0) y1 = y0 + 1;
