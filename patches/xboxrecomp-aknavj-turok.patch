+    memset(&info, 0, sizeof info);
+    info.fIcon = FALSE;
+    info.xHotspot = (DWORD)(hot_x * size / width);
+    info.yHotspot = (DWORD)(hot_y * size / height);
+    info.hbmMask = mask; info.hbmColor = color;
+    s_cursor_image = CreateIconIndirect(&info);
+    DeleteObject(color);
+    DeleteObject(mask);
+}
