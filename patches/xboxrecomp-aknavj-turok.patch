+    last[pad] = now;
+    {
+        static unsigned shown;
+        if (shown++ < 6)
+            fprintf(stderr, "[PAD] pad %d rumble %u %u\n", pad + 1, left, right);
+    }
+    vibration.wLeftMotorSpeed = left;
+    vibration.wRightMotorSpeed = right;
+    xbox_InputSetState((DWORD)pad, &vibration);
