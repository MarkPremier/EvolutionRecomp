-        *(volatile uint32_t *)(mem + s_sem_va) = param;
+        volatile uint32_t *sem = (volatile uint32_t *)(mem + s_sem_va);
+        uint32_t ahead = param - *sem;
+        static unsigned rejected;
+        if (ahead - 1u < 0x10000u)
+            *sem = param;
+        else if (ahead && (++rejected <= 8 || rejected % 1000 == 0))
+            fprintf(stderr, "[GPU] semaphore release 0x%08X rejected (semaphore"
+                    " 0x%08X): not a step forward, decoded from data (#%u)\n",
+                    param, *sem, rejected);
         return;
     }
     if (!inited) {
